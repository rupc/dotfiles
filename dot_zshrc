# -----------------------------------------------------------------------------
# 0. Zsh 옵션 (선택: 프롬프트/색 관련 안정성)
# -----------------------------------------------------------------------------
setopt PROMPT_SUBST

# -----------------------------------------------------------------------------
# 0-1. OS 감지 — 이후 모든 mac/linux 분기는 $DOTFILES_OS 로 판단
# -----------------------------------------------------------------------------
case "$(uname -s)" in
  Darwin) export DOTFILES_OS="mac" ;;
  Linux)  export DOTFILES_OS="linux" ;;
  *)      export DOTFILES_OS="other" ;;
esac

if [[ "$DOTFILES_OS" == "mac" ]]; then
  # Homebrew (Apple Silicon: /opt/homebrew, Intel: /usr/local)
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

# -----------------------------------------------------------------------------
# 1. Oh My Zsh 설정
# -----------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

# Pure를 쓸 거면 OMZ 테마는 비워두는 게 제일 깔끔함
ZSH_THEME=""

# 로드 순서 주의: fzf-tab은 앞쪽, syntax-highlighting은 뒤쪽,
# history-substring-search는 syntax-highlighting 뒤에 와야 함
plugins=(
  git
  fzf-tab
  zsh-autosuggestions
  zsh-completions
  zsh-better-npm-completion
  autojump
  kubectl
  history
  emoji
  encode64
  dirhistory
  extract
  forgit
  you-should-use
  zsh-syntax-highlighting
  zsh-history-substring-search
)

if [ -f "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# ---- Pure prompt ----
fpath=("$HOME/.zsh/pure" $fpath)

autoload -U promptinit; promptinit

# Pure 옵션(원하면 조절)
PURE_CMD_MAX_EXEC_TIME=10
zstyle :prompt:pure:path color white
zstyle ':prompt:pure:prompt:*' color cyan
zstyle :prompt:pure:git:stash show yes
prompt pure



# -----------------------------------------------------------------------------
# 2. Pure prompt (OMZ 로드 이후에 적용해야 덮어쓰기 안 당함)
# -----------------------------------------------------------------------------
autoload -U promptinit; promptinit

# -----------------------------------------------------------------------------
# 3. 사용자 정의 설정 (PATH 등)
# -----------------------------------------------------------------------------
export GOPATH=$HOME/go
if [ -d "/usr/local/go/bin" ]; then
  export PATH="$PATH:/usr/local/go/bin"
fi
# ~/.local/bin은 PATH 앞에 — setup-nvim.sh가 설치한 nvim이 공용 머신의
# 낡은 /usr/bin/nvim보다 우선해야 함
export PATH="$HOME/.local/bin:$PATH:$GOPATH/bin"

# FZF — OS가 아니라 fzf 버전 능력으로 판단 (0.48+만 --zsh 지원)
# vim-plug이 받은 최신 fzf(~/.fzf/bin)가 있으면 구버전 시스템 fzf보다 우선
[ -d "$HOME/.fzf/bin" ] && export PATH="$HOME/.fzf/bin:$PATH"
if command -v fzf >/dev/null 2>&1 && fzf --zsh >/dev/null 2>&1; then
  source <(fzf --zsh)
elif [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
  source /usr/share/doc/fzf/examples/completion.zsh
elif [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
fi

shortcuts() {
  if [ -f ~/.bash_profile ]; then
    source ~/.bash_profile
  fi
}
shortcuts

# -----------------------------------------------------------------------------
# 4. Alias
# -----------------------------------------------------------------------------
alias zshrc="vim $HOME/.zshrc"
alias soz='source ~/.zshrc'
alias k=kubectl

# -----------------------------------------------------------------------------
# 5. PNPM / Gcloud / Conda / NVM
# -----------------------------------------------------------------------------
if [[ "$DOTFILES_OS" == "mac" ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="$HOME/.local/share/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Google Cloud SDK
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# ---- Conda: 프롬프트 덮어쓰기 방지 핵심 ----
# 1) base 자동 활성화 꺼두는 걸 강추:
#    conda config --set auto_activate_base false
# 2) 그래도 conda가 prompt를 건드리면 아래로 막기:
export CONDA_CHANGEPS1=false

__conda_setup="$("$HOME/miniconda3/bin/conda" 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
  eval "$__conda_setup"
else
  if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    . "$HOME/miniconda3/etc/profile.d/conda.sh"
  elif [ -d "$HOME/miniconda3/bin" ]; then
    export PATH="$HOME/miniconda3/bin:$PATH"
  fi
fi
unset __conda_setup

# NVM (공통: ~/.nvm, mac은 Homebrew 설치 경로도 확인)
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
elif [[ "$DOTFILES_OS" == "mac" ]] && [ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ]; then
  . "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
fi

# -----------------------------------------------------------------------------
# 6. CUDA Toolkit (linux 전용 — mac은 CUDA 미지원)
# -----------------------------------------------------------------------------
if [[ "$DOTFILES_OS" == "linux" ]]; then
  if [ -d "/usr/local/cuda-13.1" ]; then
    export CUDA_HOME="/usr/local/cuda-13.1"
    export PATH="$CUDA_HOME/bin:$PATH"
    export LD_LIBRARY_PATH="$CUDA_HOME/lib64:$LD_LIBRARY_PATH"
  elif [ -d "/usr/local/cuda" ]; then
    export CUDA_HOME="/usr/local/cuda"
    export PATH="$CUDA_HOME/bin:$PATH"
    export LD_LIBRARY_PATH="$CUDA_HOME/lib64:$LD_LIBRARY_PATH"
  fi
fi

# -----------------------------------------------------------------------------
# 6-1. 개발 편의 툴 훅 (설치되어 있을 때만 로드 — mac/linux 공용)
# -----------------------------------------------------------------------------
# zoxide: 스마트 디렉토리 점프 (z <keyword>)
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
# direnv: 디렉토리 진입 시 .envrc 자동 로드
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"
# thefuck: 오타 난 직전 커맨드 교정 (오타 후 'fuck' 입력)
command -v thefuck >/dev/null 2>&1 && eval "$(thefuck --alias)"
# atuin: 히스토리 DB + Ctrl-R 퍼지검색 (↑키는 history-substring-search 몫으로 남김)
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-up-arrow)"
# history-substring-search: 입력 중인 단어로 ↑/↓ 히스토리 탐색
if (( ${+widgets[history-substring-search-up]} )); then
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi
# navi: Ctrl-G 커맨드 치트시트
command -v navi >/dev/null 2>&1 && eval "$(navi widget zsh)"
# broot: br 런처 (최초 1회 `broot --install` 실행 시 생성됨)
[ -f "$HOME/.config/broot/launcher/bash/br" ] && source "$HOME/.config/broot/launcher/bash/br"
# yazi: 종료 시 마지막 디렉토리로 cd 되는 래퍼
if command -v yazi >/dev/null 2>&1; then
  function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
      builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
  }
fi

# -----------------------------------------------------------------------------
# 6-2. 모던 CLI 배선 + 해커 감성 (2026-08)
# 전부 "설치되어 있을 때만" 활성화 — 없는 머신에서도 셸이 깨지지 않음.
# 스플래시류가 거슬리면: export DOTFILES_NO_SPLASH=1
# -----------------------------------------------------------------------------

# ---- ls/cat을 모던 대체로 배선 (지금까지 설치만 되고 안 물려 있었음) ----
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -lh --icons --git --group-directories-first'
  alias la='eza -lah --icons --git --group-directories-first'
  alias lt='eza --tree --level=2 --icons'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'
export BAT_THEME="Dracula"

# vivid: 파일 종류별 색 정의(LS_COLORS)를 모던 테마로 — eza/fd/ls 색이 확 달라짐
if command -v vivid >/dev/null 2>&1; then
  _lsc="$(vivid generate tokyonight-night 2>/dev/null)" && [ -n "$_lsc" ] && export LS_COLORS="$_lsc"
  unset _lsc
fi

# ---- fzf: fd 백엔드 + 미리보기 + 사이버 테마 ----
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi
export FZF_DEFAULT_OPTS="
  --height=80% --layout=reverse --border=rounded --info=inline
  --prompt='❯ ' --pointer='▶' --marker='✓ '
  --color=fg:#c0caf5,bg:-1,hl:#7aa2f7
  --color=fg+:#c0caf5,bg+:#283457,hl+:#7dcfff
  --color=border:#3b4261,prompt:#7dcfff,pointer:#7dcfff,marker:#9ece6a,spinner:#9ece6a,info:#565f89"
# Ctrl-T(파일): bat 미리보기 / Alt-C(디렉토리): 트리 미리보기
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:300 {} 2>/dev/null || eza --tree --level=2 --color=always {} 2>/dev/null' --preview-window=right:55%"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always --icons=always {} 2>/dev/null || ls {}'"

# fzf-tab: 탭 완성에도 미리보기 (cd 후보 디렉토리 내용 표시)
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --icons=always $realpath 2>/dev/null || ls $realpath'
zstyle ':fzf-tab:complete:(vim|nvim|bat|cat):*' fzf-preview 'bat --color=always --style=numbers --line-range=:200 $realpath 2>/dev/null || eza -1 --color=always $realpath 2>/dev/null'
zstyle ':fzf-tab:*' fzf-flags '--height=60%'

# ---- 해커 감성 ----
# fastfetch: 새 터미널 최상위 셸에서만 시스템 스플래시 (tmux/중첩 셸 제외)
if [[ -o interactive ]] && [[ $SHLVL -eq 1 && -z "$TMUX" && -z "$NVIM" && -z "$DOTFILES_NO_SPLASH" ]] \
    && command -v fastfetch >/dev/null 2>&1; then
  fastfetch
fi

# onefetch: git repo에 cd로 들어가면 repo 요약을 ASCII 로고와 함께 표시
if command -v onefetch >/dev/null 2>&1; then
  _dotfiles_onefetch_cd() {
    [[ -n "$DOTFILES_NO_SPLASH" ]] && return
    [[ -d .git ]] || return
    onefetch 2>/dev/null || true
  }
  autoload -U add-zsh-hook
  add-zsh-hook chpwd _dotfiles_onefetch_cd
fi

# -----------------------------------------------------------------------------
# 7. (안전장치) 혹시 누가 프롬프트를 또 덮으면 Pure로 다시 되돌리기
# -----------------------------------------------------------------------------
precmd() {
  prompt pure
}

