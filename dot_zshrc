# -----------------------------------------------------------------------------
# 0. Zsh 옵션 (선택: 프롬프트/색 관련 안정성)
# -----------------------------------------------------------------------------
setopt PROMPT_SUBST

# -----------------------------------------------------------------------------
# 1. Oh My Zsh 설정
# -----------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

# Pure를 쓸 거면 OMZ 테마는 비워두는 게 제일 깔끔함
ZSH_THEME=""

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-better-npm-completion
  autojump
  kubectl
  history
  emoji
  encode64
)

if [ -f "$ZSH/oh-my-zsh.sh" ]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# ---- Pure prompt ----
fpath=("$HOME/.zsh/pure" $fpath)

autoload -U promptinit; promptinit

# Pure 옵션(원하면 조절)
PURE_CMD_MAX_EXEC_TIME=10
zstyle :prompt:pure:path color white
zstyle ':prompt:pure:prompt:*' color cyan
zstyle :prompt:pure:git:stash show yes
prompt pure



# -----------------------------------------------------------------------------
# 2. Pure prompt (OMZ 로드 이후에 적용해야 덮어쓰기 안 당함)
# -----------------------------------------------------------------------------
autoload -U promptinit; promptinit

# -----------------------------------------------------------------------------
# 3. 사용자 정의 설정 (PATH 등)
# -----------------------------------------------------------------------------
export GOPATH=$HOME/go
if [ -d "/usr/local/go/bin" ]; then
  export PATH="$PATH:/usr/local/go/bin"
fi
export PATH="$PATH:$GOPATH/bin:$HOME/.local/bin"

# FZF
if [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
elif [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
  source /usr/share/doc/fzf/examples/completion.zsh
fi

shortcuts() {
  if [ -f ~/.bash_profile ]; then
    source ~/.bash_profile
  fi
}
shortcuts

# -----------------------------------------------------------------------------
# 4. Alias
# -----------------------------------------------------------------------------
alias zshrc="vim $HOME/.zshrc"
alias soz='source ~/.zshrc'
alias k=kubectl

# -----------------------------------------------------------------------------
# 5. PNPM / Gcloud / Conda / NVM
# -----------------------------------------------------------------------------
export PNPM_HOME="/home/jyr/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Google Cloud SDK
if [ -f '/home/jyr/google-cloud-sdk/path.zsh.inc' ]; then . '/home/jyr/google-cloud-sdk/path.zsh.inc'; fi
if [ -f '/home/jyr/google-cloud-sdk/completion.zsh.inc' ]; then . '/home/jyr/google-cloud-sdk/completion.zsh.inc'; fi

# ---- Conda: 프롬프트 덮어쓰기 방지 핵심 ----
# 1) base 자동 활성화 꺼두는 걸 강추:
#    conda config --set auto_activate_base false
# 2) 그래도 conda가 prompt를 건드리면 아래로 막기:
export CONDA_CHANGEPS1=false

__conda_setup="$('/home/jyr/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
  eval "$__conda_setup"
else
  if [ -f "/home/jyr/miniconda3/etc/profile.d/conda.sh" ]; then
    . "/home/jyr/miniconda3/etc/profile.d/conda.sh"
  elif [ -d "/home/jyr/miniconda3/bin" ]; then
    export PATH="/home/jyr/miniconda3/bin:$PATH"
  fi
fi
unset __conda_setup

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# -----------------------------------------------------------------------------
# 6. CUDA Toolkit
# -----------------------------------------------------------------------------
if [ -d "/usr/local/cuda-13.1" ]; then
  export CUDA_HOME="/usr/local/cuda-13.1"
  export PATH="$CUDA_HOME/bin:$PATH"
  export LD_LIBRARY_PATH="$CUDA_HOME/lib64:$LD_LIBRARY_PATH"
elif [ -d "/usr/local/cuda" ]; then
  export CUDA_HOME="/usr/local/cuda"
  export PATH="$CUDA_HOME/bin:$PATH"
  export LD_LIBRARY_PATH="$CUDA_HOME/lib64:$LD_LIBRARY_PATH"
fi

# -----------------------------------------------------------------------------
# 7. (안전장치) 혹시 누가 프롬프트를 또 덮으면 Pure로 다시 되돌리기
# -----------------------------------------------------------------------------
precmd() {
  prompt pure
}

