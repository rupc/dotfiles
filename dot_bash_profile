function docker_swarm_rejoin_node() {
    hostname=$1
    if [ -z "$hostname" ]; then
        echo "hostname is empty"
        return 0
    fi

    swarmToken=$(docker_swarm_get_token_worker)
    echo "swarmToken: $swarmToken"
    ansible "${hostname}" -m shell -a "docker swarm leave --force" -u root
    # ansible "${hostname}" -m shell -a "timedatectl set-ntp on" -u root
    ansible "${hostname}" -m shell -a "docker swarm join --token ${swarmToken} ${devMachineIP}:${devMachinePort}" -u root
    # ansible "${hostname}" -m shell -a "timedatectl set-ntp off; timedatectl set-time '2021-10-26 19:31:40'" -u root
}

function docker_swarm_get_token_worker() {
    docker swarm join-token worker | tr ' ' '\n' | grep SWMTKN
}

function docker_swarm_rejoin() {
    set -x
    down_nodes=$(docker node ls | grep Down | awk '{print $1}')
    down_hosts=$(docker node ls | grep Down | awk '{print $2}')
    echo "down nodes: $down_nodes"
    echo "down hosts: $down_hosts"
    echo "devMachineIP: $devMachineIP"
    echo "swarmToken: $swarmToken"

    swarmToken=$(docker swarm join-token worker | tr ' ' '\n' | grep SWMTKN)

    for node in $down_nodes; do
        docker node rm "${node}"
    done

    ansible "${down_hosts}" -m shell -a "docker swarm leave --force" -u root
    # ansible "${down_hosts}" -m shell -a "timedatectl set-ntp on" -u root
    ansible "${down_hosts}" -m shell -a "docker swarm join --token ${swarmToken} ${devMachineIP}:${devMachinePort}" -u root
    # ansible "${down_hosts}" -m shell -a "timedatectl set-ntp off" -u root
    # ansible "${down_hosts}" -m shell -a "timedatectl set-time '2021-10-26 19:31:40'" -u root
    set +x
}

function restartDockerNetworkForLabTestbed() {
    docker swarm leave --force

    ansibleExprHosts="bspserver,bspauditor,bspclient"
    ansibleMonitorHosts="monitor"
    ansible ${ansibleExprHosts},${ansibleMonitorHosts} -m shell -a "docker swarm leave --force" -u root
    # ansible ${ansibleExprHosts} -m shell -a "timedatectl set-ntp on" -u root

    sleep 1
    swarmToken=$(docker swarm init --advertise-addr=${devMachineIP} | tr ' ' '\n' | grep SWMTKN)

    ansible ${ansibleExprHosts},${ansibleMonitorHosts} -m shell -a "docker swarm join --token ${swarmToken} ${devMachineIP}:${devMachinePort}" -u root
    # ansible ${ansibleExprHosts} -m shell -a "timedatectl set-ntp off" -u root
    # ansible ${ansibleExprHosts} -m shell -a "timedatectl set-time '2021-10-26 19:31:40'" -u root
    #timedatectl set-ntp off && timedatectl set-time '2021-10-26 19:31:40'

    maxnumShards=24
    for ((i = 0; i < $maxnumShards; i++)); do
        networkId="edgechain$i"
        echo "creating overlay network $networkId"

        subnetsize=22
        subnet="10.$((i + 1)).0.0/$subnetsize" # 각 네트워크에 다른 서브넷 할당

        # 네트워크 존재 확인 후 삭제
        if docker network inspect $networkId >/dev/null 2>&1; then
            docker network rm $networkId
        fi

        docker network create --driver=overlay --opt encrypted=false --attachable --subnet=$subnet $networkId
    done

    # Creating a higher-level chain network
    docker network rm mec
    docker network create --driver=overlay mec
    docker network create --driver=overlay hlfcaliper
    docker network create --driver=overlay --attachable bspbench

    (
        cd /home/jyr/go/src/github.com/hyperledger/fabric/speculator/production/deploy/swarm/production || exit
        docker stack deploy --compose-file=production-monitor.yaml monitor
        docker stack deploy --compose-file=production-etcd.yaml config
    )
}

function mk() {
    local kernel_location=/usr/src/linux-$(uname -r)
    read -p "Want to copy .config in current system to $kernel_location/.config?(y/n)" yesno
    if [ $yesno == "y" ]; then
        sudo cp /boot/config-$(uname -r) $kernel_location/.config
    elif [ $yesno == "n" ]; then
        echo "New configuration file will be needed."
    fi

    echo "Number of CPU is $(nproc)"
    echo "Start kernel compile at $(date)"
    sudo make -j$(nproc)
    echo "End of compiling kernel"
    echo "End kernel compile at $(date)"
    sudo make install
    echo "End of installing kernel"

    read -p "Want to execute grub-customizer?" yesno
    if [ $yesno == "y" ]; then
        if [ -z $(ls /usr/bin/grub-customizer) ]; then
            echo "grub-customizer is not installed"
            return -1
        else
            sudo grub-customizer
        fi

    fi

    read -p "Want to reboot?" yesno
    if [ $yesno == "y" ]; then
        sudo reboot
    fi
    #make modules
}

