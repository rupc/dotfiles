# Usage: nodetags module_1 module_2 ...
# Why was I using this ???
function nodetags() {
    modules=()
    for m in $*; do
        modules+=(node_modules/$m)
    done
    echo "Including ${modules[@]}..."

    echo "Create tags for js in a root project"
    find . -type f -iregex ".*\.js$" -not -path "./node_modules/*" -exec jsctags {} -f \; | sed '/^$/d' | LANG=C sort >tags
    echo "Create tags for js in " ${modules[@]}
    find "${modules[@]}" -type f -iregex ".*\.js$" -exec jsctags {} -f \; | sed '/^$/d' >>tags
}

