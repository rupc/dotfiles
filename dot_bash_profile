function AsbUpdateEtcHostFromAnsibleHosts() {
    ANSIBLE_HOSTS_FILE=/etc/ansible/hosts

    # Iterate through the Ansible hosts file
    while IFS= read -r line; do
        # Ignore lines that start with "#"
        if [[ $line =~ ^# ]]; then
            continue
        fi

        # Check if the line contains "ansible_host=" (indicating an IP address)
        if [[ $line =~ ansible_host= ]]; then
            # Extract the IP address after "ansible_host="
            ip=$(echo $line | sed -n 's/.*ansible_host=\([0-9\.]*\).*/\1/p')

            # Extract the hostname, assuming it's at the beginning of the line
            host=$(echo $line | cut -d' ' -f 1)

            # Append to /etc/hosts (with sudo)
            echo "$ip $host" | sudo tee -a /etc/hosts
        fi
    done <"$ANSIBLE_HOSTS_FILE"

}

