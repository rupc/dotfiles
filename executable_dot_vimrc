function! LaTexConfigure()
    " Compile and View Latex documents
    nnoremap <leader>rr :call LaTeXRun(fullname)<cr>
    " View Latex documents with evince
    nnoremap <leader>rv :call LaTeXViewDocument(fullname)<cr>
    " Compile latex documents
    nnoremap <leader>rc :call LaTeXCompile(fullname)<cr>
    nnoremap <leader><leader> :call LaTeXCompile(fullname)<cr>
    autocmd BufEnter *.tex call SetCurrentWorkingFiles()|set syntax=tex
endfunction
