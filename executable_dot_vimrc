" Make build configuration
let mkloc = "." " Dependent on your proeject

function! DoMakeEdit(loc)
    let cmd=":tabnew ".a:loc."/Makefile"
    execute cmd
endfunction

function! DoMakeCompile(loc) 
    let makecmd=":!make -C ".a:loc." -j"
    execute makecmd
endfunction

function! DoMakeRun(loc)
    let makerun=":!make -C ".a:loc." run"
    execute makerun
endfunction

function! DoMakeTargetS(loc)
    let makecmd=":!make -C ".a:loc." server"
    execute makecmd
endfunction

function! DoMakeCompileAndRun(loc)
    call DoMakeCompile(a:loc)
    call DoMakeRun(a:loc)
endfunction


" Edit Makefile given location
nnoremap <leader>ma :call DoMakeEdit(mkloc)<cr>
" Make & Make(Compile & Linking)
nnoremap <leader>mm :call DoMakeCompile(mkloc)<cr>
" Make & Run
nnoremap <leader>mr :call DoMakeRun(mkloc)<cr>
" Make & Clean
nnoremap <leader>mc :make clean<cr>
" Advance : Combination of Make Compile & Run
nnoremap <leader>me :call DoMakeCompileAndRun(mkloc)<cr>
nnoremap <leader>ms :call DoMakeTargetS(mkloc)<cr>


