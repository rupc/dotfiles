    " jupytext percent 포맷(# %%) 기준 현재 셀 실행
    function! MoltenRunCell() abort
        let l:cur_start = search('^# %%', 'bcnW')
        let l:cur_end = search('^# %%', 'nW')
        let l:cell_start = l:cur_start == 0 ? 1 : l:cur_start + 1
        let l:cell_end = l:cur_end == 0 ? line('$') : l:cur_end - 1
        if l:cell_start > l:cell_end | return | endif
        call MoltenEvaluateRange(l:cell_start, l:cell_end)
    endfunction

    " Ctrl+Enter = 현재 셀 실행 (kitty에서 동작; 구분 못 하는 터미널은 ,rc 사용)
    nnoremap <silent> <C-CR> :call MoltenRunCell()<CR>
    nnoremap <silent> <leader>rc :call MoltenRunCell()<CR>
    nnoremap <silent> <leader>mi :MoltenInit<CR>
    nnoremap <silent> <leader>ml :MoltenEvaluateLine<CR>
    vnoremap <silent> <leader>mr :<C-u>MoltenEvaluateVisual<CR>
    nnoremap <silent> <leader>mo :MoltenShowOutput<CR>
    nnoremap <silent> <leader>md :MoltenDelete<CR>
