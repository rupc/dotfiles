" 내장 LSP (nvim 0.11+) — coc.nvim 대체 (2026-07). Node 불필요.
" 서버 실행파일이 있을 때만 활성화되므로, 서버가 없는 머신에서도 에러 없이 동작.
" python 서버(basedpyright)는 setup-nvim.sh가 ~/.venvs/nvim에 설치.
" go는 vim-go가 gopls를 직접 띄우므로 여기 넣지 않음 (이중 실행 방지).
" ----------------------------------------------------------------------------
if s:nvim_ok
lua << EOF
local venv_bin = vim.fn.expand('~/.venvs/nvim/bin')
local function find_bin(name)
  local v = venv_bin .. '/' .. name
  if vim.fn.executable(v) == 1 then return v end
  if vim.fn.executable(name) == 1 then return name end
  return nil
end

local servers = {
  basedpyright = {
    bin = 'basedpyright-langserver', args = { '--stdio' },
    filetypes = { 'python' },
    root_markers = { 'pyproject.toml', 'setup.py', 'requirements.txt', '.git' },
    settings = { basedpyright = { analysis = { typeCheckingMode = 'basic' } } },
  },
  rust_analyzer = {
    bin = 'rust-analyzer',
    filetypes = { 'rust' },
    root_markers = { 'Cargo.toml', '.git' },
  },
  clangd = {
    bin = 'clangd',
    filetypes = { 'c', 'cpp', 'cuda' },
    root_markers = { 'compile_commands.json', 'compile_flags.txt', '.git' },
  },
  -- go: 완성·gd·진단은 여기(내장 LSP)로 통일. vim-go는 빌드/테스트/커버리지 담당
  gopls = {
    bin = 'gopls',
    filetypes = { 'go', 'gomod', 'gowork', 'gotmpl' },
    root_markers = { 'go.work', 'go.mod', '.git' },
  },
  -- sh: setup-nvim.sh가 설치 (node 기반). shellcheck이 PATH에 있으면 진단도 통합
  bashls = {
    bin = 'bash-language-server', args = { 'start' },
    filetypes = { 'sh', 'bash' },
    root_markers = { '.git' },
  },
  -- js/ts: setup-nvim.sh가 만드는 래퍼 — TS7+면 네이티브 'tsc --lsp',
  -- 구세대 TS 머신이면 typescript-language-server 로 내부에서 분기
  ts_ls = {
    bin = 'ts-lsp',
    filetypes = { 'javascript', 'javascriptreact', 'typescript', 'typescriptreact' },
    root_markers = { 'tsconfig.json', 'jsconfig.json', 'package.json', '.git' },
  },
  -- yaml: k8s 매니페스트 등 스키마 검증 (helm 템플릿은 filetype=helm이라 제외됨)
  yamlls = {
    bin = 'yaml-language-server', args = { '--stdio' },
    filetypes = { 'yaml' },
    root_markers = { '.git' },
  },
  -- toml: Cargo.toml/pyproject.toml 스키마 검증
  taplo = {
    bin = 'taplo', args = { 'lsp', 'stdio' },
    filetypes = { 'toml' },
    root_markers = { '.git' },
  },
}

-- nvim-cmp가 있으면 서버에 확장 completion capability 광고 (스니펫 등)
local caps = vim.lsp.protocol.make_client_capabilities()
local ok_cmp_lsp, cmp_lsp = pcall(require, 'cmp_nvim_lsp')
if ok_cmp_lsp then caps = cmp_lsp.default_capabilities() end

for name, s in pairs(servers) do
  local exe = find_bin(s.bin)
  if exe then
    local cmd = { exe }
    vim.list_extend(cmd, s.args or {})
    vim.lsp.config(name, {
      cmd = cmd,
      filetypes = s.filetypes,
      root_markers = s.root_markers,
      settings = s.settings,
      capabilities = caps,
    })
    vim.lsp.enable(name)
  end
end

-- 자동완성: nvim-cmp. 미설치 상태(첫 PlugInstall 전)면 내장 completion 폴백
local cmp_ok, cmp = pcall(require, 'cmp')
if cmp_ok then
  cmp.setup({
    snippet = {
      expand = function(args) vim.fn['UltiSnips#Anon'](args.body) end,
    },
    -- <c-n>/<c-p> 이동(insert 프리셋 기본), <cr>=선택항목 확정, <c-y>=첫항목 확정
    mapping = cmp.mapping.preset.insert({
      ['<C-Space>'] = cmp.mapping.complete(),
      ['<C-e>'] = cmp.mapping.abort(),
      ['<CR>'] = cmp.mapping.confirm({ select = false }),
      ['<C-y>'] = cmp.mapping.confirm({ select = true }),
    }),
    sources = cmp.config.sources({
      { name = 'nvim_lsp' },
      { name = 'ultisnips' },
    }, {
      { name = 'buffer' },
      { name = 'path' },
    }),
  })
else
  vim.api.nvim_create_autocmd('LspAttach', {
    group = vim.api.nvim_create_augroup('my.lsp.completion', {}),
    callback = function(ev)
      local client = vim.lsp.get_client_by_id(ev.data.client_id)
      if client and client:supports_method('textDocument/completion') then
        vim.lsp.completion.enable(true, client.id, ev.buf, { autotrigger = true })
      end
    end,
  })
end
vim.diagnostic.config({ virtual_text = true, severity_sort = true })

-- 신택스 하이라이팅: treesitter (main 브랜치 API)
-- 파서는 stdpath('data')/site 에 설치·유지된다. tree-sitter CLI가 없으면
-- 신규 설치만 건너뛰고, 이미 설치된 파서는 CLI 없이도 동작.
local ts_ok, ts = pcall(require, 'nvim-treesitter')
if ts_ok and ts.install then
  vim.g.my_ts_langs = {
    'bash', 'python', 'lua', 'vim', 'vimdoc', 'go', 'rust',
    'c', 'cpp', 'cuda', 'yaml', 'json', 'toml', 'proto',
    'javascript', 'typescript', 'tsx',
    'markdown', 'markdown_inline', 'make', 'dockerfile', 'diff',
  }
  if vim.fn.executable('tree-sitter') == 1 then
    pcall(ts.install, vim.g.my_ts_langs)  -- async, 이미 설치된 파서는 no-op
  end
  -- main은 자동 하이라이팅이 없음 — 파서 있는 파일타입만 직접 시작
  vim.api.nvim_create_autocmd('FileType', {
    group = vim.api.nvim_create_augroup('my.treesitter', {}),
    callback = function(ev)
      if pcall(vim.treesitter.start, ev.buf) and ev.match ~= 'python' then
        -- treesitter 들여쓰기 (python은 pep8-indent 플러그인 유지)
        vim.bo[ev.buf].indentexpr = "v:lua.require'nvim-treesitter'.indentexpr()"
      end
    end,
  })
end

