" LaTeX Settings
" global variable prefixed by g:
function! LaTeXRun(file)
    let dvifile=g:filename.".dvi"
    " let cmd = "!latex ".a:file." && "."xdvi ".dvifile. " -s 3"
    let pdffile=g:filename.".pdf"
    let cmd = "!pdflatex ".a:file." && "."evince ".pdffile
    execute cmd
endfunction

function! LaTeXCompile(file)
    let dvifile=g:filename.".dvi"
    let cmd = "!pdflatex ".a:file
    execute cmd
endfunction

function! LaTeXViewDocument(file)
    let pdffile=g:filename.".pdf"
    let cmd = "!evince ".pdffile." &"
    execute cmd
endfunction
